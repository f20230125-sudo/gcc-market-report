table fact_products
	lineageTag: 69473b76-b64e-5943-a125-b2759b29ec90

	measure Products = COUNTROWS(fact_products)
		formatString: #,##0
		displayFolder: Measures
		lineageTag: de3f766f-b76c-5b10-83b4-02736164830e

	measure 'MSD Products' = CALCULATE(COUNTROWS(fact_products), fact_products[role] = "MSD")
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 21d8dd1d-e5cb-52fc-8ac4-fe4548540c4c

	measure 'Generic Versions' = CALCULATE(COUNTROWS(fact_products), fact_products[role] = "Generic or other")
		formatString: #,##0
		displayFolder: Measures
		lineageTag: ce148a71-e96c-51db-afaa-a8a62005a16c

	measure 'Other Brands' = CALCULATE(COUNTROWS(fact_products), fact_products[role] = "Originator")
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 347699c3-40ff-547b-b9a7-6c96b8ff8595

	measure Companies = DISTINCTCOUNT(fact_products[company])
		formatString: #,##0
		displayFolder: Measures
		lineageTag: 4212675c-bfba-57a1-802f-09f9279401d5

	measure 'Median Price per Unit USD' = MEDIAN(fact_products[price_per_unit_usd])
		formatString: "$"#,##0.00
		displayFolder: Measures
		lineageTag: cea61826-0658-5f2d-a580-46042c1217b2

	measure 'MSD Lowest per Unit USD' = CALCULATE(MIN(fact_products[price_per_unit_usd]), fact_products[role] = "MSD")
		formatString: "$"#,##0.00
		displayFolder: Measures
		lineageTag: e5cc5047-11ff-53d6-8ff4-434eaeae2095

	measure 'Cheapest Generic per Unit USD' = CALCULATE(MIN(fact_products[price_per_unit_usd]), fact_products[role] = "Generic or other")
		formatString: "$"#,##0.00
		displayFolder: Measures
		lineageTag: 2c4218ac-2f4a-5a63-914f-dcad8ba73a06

	measure 'Cheapest Generic vs MSD' = IF(ISBLANK([Cheapest Generic per Unit USD]) || ISBLANK([MSD Lowest per Unit USD]), BLANK(), DIVIDE([Cheapest Generic per Unit USD], [MSD Lowest per Unit USD]) - 1)
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: e4163538-753e-502c-b56f-d0fe799463fe

