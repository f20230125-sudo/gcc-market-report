	partition fact_products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_products.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"pid", Int64.Type}, {"country", type text}, {"atc5", type text}, {"ingredient", type text}, {"name", type text}, {"brand", type text}, {"strength", type text}, {"form", type text}, {"units_per_pack", type number}, {"pack_price_local", type number}, {"currency", type text}, {"price_per_unit_usd", type number}, {"role", type text}, {"company", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
