table fact_bahrain_changes
	lineageTag: ca8c107d-ff93-50da-b8c8-f4b88e84dfc7

	measure 'Prices Matched' = COUNTROWS(fact_bahrain_changes)
		formatString: 0
		displayFolder: Measures
		lineageTag: ddc067ff-2f8a-5261-bc6d-a0907dfb6b4a

	measure 'Share Unchanged' = DIVIDE(CALCULATE(COUNTROWS(fact_bahrain_changes), fact_bahrain_changes[direction] = "Unchanged"), COUNTROWS(fact_bahrain_changes))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 8f1c8fa4-01c7-5d1a-a019-c4b1a9d08bd8

	measure 'Median Change' = MEDIAN(fact_bahrain_changes[change])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: acb14857-1cb7-52eb-b034-51331c6fce7b

	column reg_no
		dataType: string
		lineageTag: c7e75eaa-880d-57d6-8ded-4297262af994
		summarizeBy: none
		sourceColumn: reg_no

	column name
		dataType: string
		lineageTag: 1922f822-891f-55c6-ac97-e8b5d71fb211
