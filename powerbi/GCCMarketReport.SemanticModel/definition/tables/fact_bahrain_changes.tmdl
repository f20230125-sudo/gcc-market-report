	partition fact_bahrain_changes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bahrain_changes.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"reg_no", type text}, {"name", type text}, {"list_2024", type text}, {"price_feb_2024_bd", type number}, {"price_sep_2026_bd", type number}, {"change", type number}, {"direction", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
